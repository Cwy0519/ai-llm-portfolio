# ============================================================
# AI 智能写作助手 - 环境变量模板
# 使用方法：复制本文件为 .env，然后填写自己的 API Key。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库。
# ============================================================

# ---------- 大模型 API 配置（OpenAI 兼容接口） ----------
# API Key，必填
LLM_API_KEY=

# 接口地址，需以 /v1 结尾（不同服务商的地址见文末示例）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 采样温度：0.0-2.0，越大越发散；写作场景建议 0.7-1.0
LLM_TEMPERATURE=0.8

# 单次生成的最大 token 数
LLM_MAX_TOKENS=2048

# 请求超时时间（秒）
LLM_TIMEOUT=60

# ---------- Web 界面配置 ----------
APP_HOST=127.0.0.1
APP_PORT=7860
# 启动后是否自动打开浏览器：1=是，0=否
APP_INBROWSER=1

# ---------- 其他服务商配置示例（按需替换上方三项） ----------
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
# 阿里云百炼:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 月之暗面:    LLM_BASE_URL=https://api.moonshot.cn/v1       LLM_MODEL=moonshot-v1-8k
# 智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
# 本地 Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama
