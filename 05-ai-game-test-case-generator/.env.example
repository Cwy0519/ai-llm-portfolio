# ===== 大模型接口（必填）=====
# 把本文件复制为 .env，填入你自己的 Key
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 生成参数 =====
# 温度越低越稳定，测试用例建议 0.2–0.5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
LLM_TIMEOUT=60
# 一次最多生成多少条（界面滑块上限受它约束）
MAX_CASES=30
# 失败自动重试次数
RETRIES=2
# 1=要求模型输出 JSON 对象（推荐）；某些平台不支持时改 0
JSON_MODE=1

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=7862

# ===== 常见平台配置对照（换平台时改上面三行即可，代码不用动）=====
# DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
# 智谱 GLM      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# 通义千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 月之暗面      LLM_BASE_URL=https://api.moonshot.cn/v1             LLM_MODEL=moonshot-v1-8k
# OpenAI        LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o-mini
# 本地 Ollama   LLM_BASE_URL=http://127.0.0.1:11434/v1               LLM_MODEL=qwen2.5
