# ===== 把这个文件复制一份，改名为 .env，然后填上你自己的值 =====
# 注意：.env 已经在 .gitignore 里，不会被提交，也不会泄露到网上。

# 你的 API Key（必填）
LLM_API_KEY=在这里填你的key

# 接口地址（下面默认是 DeepSeek，换平台就改这里）
# DeepSeek   https://api.deepseek.com/v1
# 智谱 GLM   https://open.bigmodel.cn/api/paas/v4
# 通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
# 月之暗面   https://api.moonshot.cn/v1
# 本地Ollama http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（要跟你用的平台一致）
# DeepSeek: deepseek-chat   智谱: glm-4-flash   通义: qwen-plus
# 月之暗面: moonshot-v1-8k  Ollama: qwen2.5:7b
LLM_MODEL=deepseek-chat

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 长文本按多少字切一段（越大越快，但太长容易超限；800~1500 比较稳）
MAX_CHARS=1200

# 随机性：0 最稳定，1 最发散；翻译/润色建议 0.2~0.4
TEMPERATURE=0.3

# 网络失败自动重试次数
MAX_RETRIES=2
